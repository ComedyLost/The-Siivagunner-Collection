import funkin.play.character.CharacterType;
import funkin.play.character.AnimateAtlasCharacter;
import funkin.play.PlayState;
import funkin.graphics.FunkinSprite;
import funkin.audio.visualize.ABotVis;
using StringTools;
class KoumeCharacter extends AnimateAtlasCharacter
{

  function new()
  {
    super('koume');
  }

  private var setupProps:Bool = false;
  public var isMyReisenKindaSpeakerless:Bool = false;
  public var speakers:FunkinSprite;
  private var currentShader = null;
  private var adjustColor:AdjustColorShader;
  public override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    if (!isMyReisenKindaSpeakerless) {
      speakers = FunkinSprite.createTextureAtlas(0, 0, 'characters/Speakers', 'shared');
      speakers.anim.addByFrameLabel('idle', 'Idle', 24, false);
    }
  }
  override public function onUpdate(e) {
    super.onUpdate(e);
    if (currentStage == null || isMyReisenKindaSpeakerless) return;
    if (setupProps)
      synchronizeShader();
    else {
      addProps();
    }
    this.origin.set(this.width / 2, this.height / 2);
    this.angle += 0.50;
  }
  override public function onSongStart(e) {
    super.onSongStart(e);
    speakerBump();
  }
  override function onAdd(event:ScriptEvent):Void
  {
    if (this.characterType == CharacterType.DAD)
    {
      var pos:FlxPoint = currentStage.getGirlfriendPosition();
      this.originalPosition.x = pos.x - this.characterOrigin.x;
      this.originalPosition.y = pos.y - this.characterOrigin.y;
      this.resetPosition();
    }
  }
  private function addProps() {
    if (setupProps) return;
    if (!isMyReisenKindaSpeakerless) {
      speakers.zIndex = this.zIndex - 2;
      currentStage.add(speakers);
      speakers?.setPosition(this.x - 56 - (-this.globalOffsets[0] * this.scale.x), this.y + 406 - (-this.globalOffsets[1] * this.scale.y));
    }
    currentStage.refresh();
    setupProps = true;
  }
  function synchronizeShader():Void {
    if (currentShader == this.shader) return;
    currentShader = this.shader;
    speakers.shader = currentShader;
    trace("Synchronized shader between children!");
  }
  override function dance(force:Bool):Void
  {
    if (!force && getCurrentAnimation().startsWith('hair') && !isAnimationFinished()) return;
    speakerBump(force);
    super.dance(force);
  }
  private function speakerBump(force:Bool = true) {
    if (!isMyReisenKindaSpeakerless && setupProps) {
      speakers?.anim?.play('idle', true);
    }
  }
}
