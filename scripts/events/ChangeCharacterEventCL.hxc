import funkin.play.PlayState;
import funkin.play.event.SongEvent;

import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;

import funkin.play.character.CharacterDataParser;
import funkin.play.character.CharacterType;
import funkin.play.components.HealthIcon;
import funkin.FunkinMemory;
import haxe.ds.StringMap;

import funkin.modding.events.ScriptEvent;
import funkin.modding.events.ScriptEventDispatcher;

class ChangeCharacterEventCL extends SongEvent {

    function setCharacter(character:String = 'bf', newChar:String, ?currentZIndex:Bool = false, ?fromCache:Bool = false) {
        var characterData = switch (character) {
            case 'bf': [PlayState.instance?.currentStage?.getBoyfriend(), CharacterType.BF];
            case 'gf': [PlayState.instance?.currentStage?.getGirlfriend(), CharacterType.GF];
            case 'dad': [PlayState.instance?.currentStage?.getDad(), CharacterType.DAD];
        }
        var crh = ModuleHandler.getModule("CharacterResetHandlerCL");
        var curZIndex:Int = crh.characterZIndexes[character];
        if (characterData[0] != null) {
            if (currentZIndex) curZIndex = characterData[0].zIndex;
            characterData[0].destroy();
        }
        var newCharacter = (fromCache ? crh.cachedCharacters.get(newChar).shift() : CharacterDataParser.fetchCharacter(newChar));
        if (newCharacter != null) {
            if (fromCache) {
                var event = new ScriptEvent('CREATE', true);
                ScriptEventDispatcher.callEvent(newCharacter, event);
                event.cancel();
            }
			PlayState.instance.currentStage.addCharacter(newCharacter, characterData[1]);
			newCharacter.zIndex = curZIndex;
        }
    }

    public override function handleEvent(data) {
		if (PlayState.instance == null || PlayState.instance.currentStage == null) return;
		if (PlayState.instance.isMinimalMode) return;

        setCharacter(data.value.character, data.value.newchar, true, true);

        PlayState.instance.currentStage.refresh();
	}

	public function getEventSchema() {
        var characterList = ["Boyfriend" => "bf", "Daddy Dearest" => "dad"];
        var charIds:Array<String> = CharacterDataParser.listCharacterIds();

        for (charId in charIds)
        {
          var character:Null<CharacterData> = CharacterDataParser.fetchCharacterData(charId);
          characterList.set(character.name, charId);
        }    
		return [
            {
                name: "character",
                title: "Old Character",
                defaultValue: "bf",
				type: "enum",
				keys: [
					"Boyfriend" => "bf",
					"Girlfriend" => "gf",
					"Dad" => "dad"
				]
            },
            {
                name: "newchar",
                title: "New Character",
                defaultValue: "bf",
                type: "enum",
                keys: characterList,
            }
		];
	}

	public function getTitle() {
		return "Change Character (CL Ver.)";
	}
	
	public function new() {
		super('ChangeCharacterCL', {processOldEvents: true});
	}
}