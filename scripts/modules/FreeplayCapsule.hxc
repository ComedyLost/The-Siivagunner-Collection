import funkin.modding.module.Module;
import flixel.FlxG;
import funkin.Paths;
import funkin.ui.freeplay.FreeplayState;
import funkin.util.ReflectUtil;
import funkin.ui.freeplay.SongMenuItem;
import funkin.audio.FunkinSound;
import funkin.modding.base.ScriptedMusicBeatSubState;
import StringTools;
import flixel.util.FlxTimer;
import funkin.PlayerSettings;
import funkin.util.TouchUtil;
import funkin.util.SwipeUtil;
import funkin.data.story.level.LevelRegistry;
import openfl.display.BitmapData;
import flixel.FlxSprite;
import openfl.display.Bitmap;
import funkin.input.Cursor;
import funkin.modding.ModStore;
import funkin.save.Save;

using StringTools;
using Lambda;

class SiivaGunnerFreeplayCapsule extends Module {

	public function new(){
		super('SiivaGunnerFreeplayCapsule');
	}

	override function onSubStateOpenEnd(event) {
        super.onSubStateOpenEnd(event);
		if (!Std.isOfType(event.targetState, FreeplayState)) return;
		var baseSongs = LevelRegistry.instance.listBaseGameEntryIds();
		insertAfterWeek(baseSongs[baseSongs.length - 1], listBaseSiivaEntryIds());
		if (!Save.instance.hasBeatenSong('rotten', ['siiva'])) {
			var albumId = FlxG.state.subState.currentCapsule?.freeplayData?.data?.getAlbumId(FlxG.state.subState.currentDifficulty, FlxG.state.subState.currentVariation);
			event.targetState?.dj?.onIntroDone.add(() -> {
				if (albumId == 'volumeROTTEN') {
					FlxG.state.subState.albumRoll.albumId = 'volumeHQ'; // Hide 
				}
			});	
		}
		for (dot in event.targetState.difficultyDots.members) {
			if (dot.difficultyId == 'siiva') dot.normalColors = [0xFF484848, 0xFFE57462, 0xFF919191, 0xFF484848];
		}
	}

	function listBaseSiivaEntryIds() {
		return [
			'tutorialSiiva',
			'week1Siiva',
			'week2Siiva',
			'week3Siiva',
			'week4Siiva',
			'week5Siiva',
			'week6Siiva',
			'week7Siiva',
			'weekend1Siiva',
			'weekExtrasSiiva'
		  ];
	}

	function insertAfterWeek(weekName:String, songs:Array<String>) {
		var levels = [];
		var hasSeenWeek = false;
		for (song in FlxG.state.subState.songs.copy()) {
			if (song != null && songs.contains(song?.levelId)) {
				FlxG.state.subState.songs.remove(song);
				levels.push(song);
			}
		}
		if (levels.length == 0) return; // Don't do custom positioning if the song isn't even there
		var levelIds = [];
		for (song in FlxG.state.subState.songs) {
			if ((song?.levelId ?? '') == weekName && !hasSeenWeek) hasSeenWeek = true;
			if (!levelIds.contains(song?.levelId)) levelIds.push(song?.levelId);
			if (hasSeenWeek && (song?.levelId) != weekName) {
				for (item in levels) {
					FlxG.state.subState.songs.insert(FlxG.state.subState.songs.indexOf(song), item);
				}
				levels = [];
				break;
			}
		}
		if (levels.length != 0) { // Assume there's no other songs present
			for (item in levels) {
				FlxG.state.subState.songs.push(item);
			}
			levels = [];
		}
		var capsules = [];
		var hasSeenCapsule = false;
		for (capsule in FlxG.state.subState.grpCapsules.members.copy()) {
			if (capsule?.freeplayData == null) continue;
			if (songs.contains(capsule?.freeplayData?.levelId)) {
				FlxG.state.subState.grpCapsules.members.remove(capsule);
				capsules.push(capsule);
			}
		}
		if (capsules.length > 0) {
			var neededLevel:String;
			var insertedCapsules:Bool = false;
			for (capsule in FlxG.state.subState.grpCapsules.members) {
				if (capsule?.freeplayData == null) continue;
				if (levelIds.contains(capsule?.freeplayData?.levelId) && levelIds.indexOf(capsule?.freeplayData?.levelId) <= levelIds.indexOf(weekName))
					continue;
				else {
					insertedCapsules = true;
					for (item in capsules) {
						FlxG.state.subState.grpCapsules.members.insert(FlxG.state.subState.grpCapsules.members.indexOf(capsule), item);
					}	
					break;
				}
			}
			if (!insertedCapsules) {
				for (item in capsules) {
					FlxG.state.subState.grpCapsules.members.push(item);
				}
			}
			FlxG.state.subState?.grpCapsules?.forEachAlive(function(funnyMenu:SongMenuItem) {
				var curIndex = FlxG.state.subState.grpCapsules.members.indexOf(funnyMenu);
				funnyMenu.targetPos.x = funnyMenu.x;
				funnyMenu.ID = curIndex;
				funnyMenu.index = curIndex + 1;
				if (FlxG.state.subState.forceSkipIntro || FlxG.state.subState.fromCharSelect) funnyMenu.forcePosition();
				else {
					funnyMenu.initPosition(FlxG.width, 0);
					funnyMenu.initJumpIn(0, true);
				}
			});
			if (FreeplayState.rememberedSongId != null) {
				FlxG.state.subState.curSelected = FlxG.state.subState.grpCapsules.findIndex(function(capsule) {
					if (capsule == null) return false;
					return capsule.freeplayData?.data?.id == FreeplayState.rememberedSongId;
				});		
			}
			if (FlxG.state.subState.curSelected == -1) FlxG.state.subState.curSelected = 0;
			FlxG.state.subState.changeSelection();		
		}
	}

	function weekText(cap:SongMenuItem) {
		if (cap?.freeplayData == null) return;
		var songID = cap.freeplayData.data.id;
		//trace(songID);
		var swagGoodArray:Array<String> = [];
		var extractedSongID:String;
		swagGoodArray = songID.split('-');
		if (songID.contains('philly-nice') || songID.contains('winter-horrorland') || songID.contains('satin-panties') || songID.contains('lit-up')) 
			extractedSongID = swagGoodArray[0] + '-' + swagGoodArray[1]; 
		else 
			extractedSongID = swagGoodArray[0];
		if (!cap.weekType.graphic.key.contains('freeplay/freeplayCapsule/weektypes')) {
	   		cap.weekType.frames = Paths.getSparrowAtlas('freeplay/freeplayCapsule/weektypes');
		    cap.weekType.animation.addByPrefix('WEEK', 'WEEK text instance 1', 24, false);
	    	cap.weekType.animation.addByPrefix('WEEKEND', 'WEEKEND text instance 1', 24, false);
		}
		cap.checkWeek(extractedSongID);
		switch (songID) {
			case 'ice-roses': cap.checkWeek('roses');
			case 'smooth-sherbet-alpha-mix': cap.checkWeek('eggnog');
			case 'spookeez-beta-mix': // Override the confirm to take a screenshot of the game to use in the song
				var onConfirmOG:Void->Void = cap.onConfirm;
				cap.onConfirm = () -> {
					if (FlxG.state.subState.controls.active) {
						Cursor.hide();
						FlxG.mouse.visible = false;
						var shot:Bitmap = new Bitmap(BitmapData.fromImage(FlxG.stage.window.readPixels()));
						ModStore.stores.set('FreeplayScreenshot', shot.bitmapData);
						// FlxG.state.subState.add(preview);
					}
					onConfirmOG();
				};
			case 'eggnog-unused-mix':
				cap.pixelIcon.origin.x = 140;
			case 'rotten':
				if (Save.instance.hasBeatenSong('rotten', ['siiva'])) return;
				cap?.songText.text = '';
				for (length in 0...cap?.freeplayData?.fullSongName.length) {
					switch (cap?.freeplayData?.fullSongName.charAt(length)) {
						case ' ', '(', ')', '-': cap?.songText.text += cap?.freeplayData?.fullSongName.charAt(length);
						default: cap?.songText.text += '?';
					}
				}
		}
	}

	/**
	 * Gets the original (non-rip) version of the song
	 * @param siivaSong The id of the rip verson of the song
	 */
	public function getOriginalSong(siivaSong:String) {
		var swagGoodArray:Array<String> = [];
		var extractedSongID:String;
		swagGoodArray = siivaSong.split('-');
		if (siivaSong.contains('philly-nice') || siivaSong.contains('winter-horrorland') || siivaSong.contains('satin-panties') || siivaSong.contains('lit-up')) 
			extractedSongID = swagGoodArray[0] + '-' + swagGoodArray[1]; 
		else 
			extractedSongID = swagGoodArray[0];
		return extractedSongID;
	}

	public function onDifficultySwitch(event:CapsuleScriptEvent):Void {
		super.onDifficultySwitch(event);
		if (event.difficultyId == 'siiva') {
			if (FlxG.state.subState.ostName.text != "GRAND OST") {
				FlxG.state.subState.ostName.text = "GRAND OST";
				FlxG.state.subState.ostName.shader.width = FlxG.state.subState.ostName.shader.height = 2;
				FlxTimer.wait(1.5 / 24, () -> {
					FlxG.state.subState.ostName.shader.width = FlxG.state.subState.ostName.shader.height = 0;
				});
			}
		} else if (FlxG.state.subState.ostName.text == "GRAND OST") {
			FlxG.state.subState.ostName.text = "OFFICIAL OST";
			FlxG.state.subState.ostName.shader.width = FlxG.state.subState.ostName.shader.height = 2;
			FlxTimer.wait(1.5 / 24, () -> {
				FlxG.state.subState.ostName.shader.width = FlxG.state.subState.ostName.shader.height = 0;
			});
		}

		if (event.difficultyId != 'siiva') return;
		var filteredCapsules:Array<SongMenuItem> = FlxG.state.subState.grpCapsules.members.filter(function(cap:SongMenuItem) {
			   // Dead capsules are ones which were removed from the list when changing filters.
			return cap != null && cap.alive && cap.freeplayData != null;
		  });
		for (capsule in filteredCapsules){
			if (capsule == null || !capsule.alive) continue;

			weekText(capsule);
		}
	}

	public function onCapsuleSelected(event:CapsuleScriptEvent):Void { // Fix Eggnog Unused Mix icon being offset incorrectly
		switch (event.capsule?.freeplayData?.data?.id) {
			case 'eggnog-unused-mix': event.capsule?.pixelIcon?.origin.x = 140;
			case 'rotten': 
				if (Save.instance.hasBeatenSong('rotten', ['siiva'])) return;
				FlxTimer.globalManager._timers.pop().cancel();
				FlxG.state.subState.clearPreviews();
				event.capsule?.songText.text = '';
				for (length in 0...event.capsule?.freeplayData?.fullSongName.length) {
					switch (event.capsule?.freeplayData?.fullSongName.charAt(length)) {
						case ' ', '(', ')', '-': event.capsule?.songText.text += event.capsule?.freeplayData?.fullSongName.charAt(length);
						default: event.capsule?.songText.text += '?';
					}
				}
				//event.capsule?.songText.text = '??????';
				if (FlxG.state.subState.albumRoll.albumId == null) return;
				FlxG.state.subState.albumRoll.albumId = 'volumeHQ';
		}
	}
}