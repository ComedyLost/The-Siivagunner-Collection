import funkin.play.PlayState;
import funkin.play.event.SongEvent;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.save.Save;
import funkin.Conductor;
import StringTools;
import flixel.util.FlxSave;

class OldSchoolHolds extends Module
{
    function new() {
        super('OldSchoolHolds', null, {state: PlayState});

		save = new FlxSave();
		save.bind("SiivaOptions", "FunkinCrew");
    }

	final ANIMATION_TIMER_LIMIT:Float = 0.16666667;
	var animationTimers:Array<Float> = [0.0, 0.0];
	
	function onUpdate(event:UpdateScriptEvent):Void {
		super.onUpdate(event);
		if (!save.data.siivastutter) return;
		if (PlayState.instance == null) return;
		for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members) {
			if (holdNote == null || !holdNote.alive || holdNote.noteData == null)
				continue;
	
			// While the hold note is being hit, and there is length on the hold note...
			if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0) {
				animationTimers[0] += event.elapsed;
	
				var dad:Null<AnimateAtlasCharacter> = PlayState.instance.currentStage?.getDad();
	
				// Make sure the opponent keeps singing while the note is held.
				if (PlayState.instance.currentStage != null && dad != null && dad.isSinging() && animationTimers[0] >= ANIMATION_TIMER_LIMIT) {
					animationTimers[0] = 0.0;
					dad.playSingAnimation(holdNote.noteDirection);
					dad.holdTimer = 0;
				}
			}
		}
	
		for (holdNote in PlayState.instance.playerStrumline.holdNotes.members) {
			if (holdNote == null || !holdNote.alive || holdNote.noteData == null)
				continue;
	
			// While the hold note is being hit, and there is length on the hold note...
			if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0) {
				animationTimers[1] += event.elapsed;
	
				var bf:Null<AnimateAtlasCharacter> = PlayState.instance.currentStage?.getBoyfriend();
	
				// Make sure the player keeps singing while the note is held.
				if (PlayState.instance.currentStage != null && bf != null && bf.isSinging() && animationTimers[1] >= ANIMATION_TIMER_LIMIT) {
					animationTimers[1] = 0.0;
					bf.playSingAnimation(holdNote.noteDirection);
					bf.holdTimer = 0;
				}
			}
		}
	}
}
