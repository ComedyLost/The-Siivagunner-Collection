import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.PlayerSettings;
import funkin.Highscore;
import funkin.ui.options.OptionsState;
import funkin.save.Save;
import funkin.ui.options.PreferencesMenu;
import flixel.util.FlxSave;
import lime.app.Application;
import funkin.modding.ModStore;
import funkin.ui.Prompt;
import funkin.ui.ButtonStyle;

class SiivaOptions extends Module
{
	var save:FlxSave;

	function new(){
		super("siivaOptions");

		save = new FlxSave();
		save.bind("SiivaOptions", "FunkinCrew");
		save.data.siivatitle ??= true;
		save.data.siivarechart ??= true;
		save.data.siivacutscenes ??= false;
		save.data.siivavocals ??= true;
		save.data.siivaexfx ??= true;
		save.data.rottenshader ??= (FlxG.onMobile ? false : true); // Mobile seems to have a hard time with the shader
		save.data.siivatray ??= true;
		save.data.siivadeath ??= true;
		save.data.siivalunch ??= true;
		save.data.siivaresults ??= true;
		save.data.siivastutter ??= false;
		save.data.siivastrum ??= false;

		save.flush();		
	}

	function onStateChangeEnd(callback) {
		super.onStateChangeEnd(callback);
		if (!Std.is(callback.targetState, OptionsState))
			return;
		var prefs:PreferencesMenu = callback.targetState.optionsCodex.addPage('siiva', new PreferencesMenu());
		prefs.onExit.add(function() {
			FlxG.state.optionsCodex.switchPage('options');
		});
		prefs.preferenceDesc = [];
		prefs.items.clear();	
		prefs.preferenceItems.clear();
		var optionspage = callback.targetState.optionsCodex.pages.get('options');
		var exit = optionspage.items.getItem("EXIT") ?? null;
		var option = optionspage.createItem("SiivaGunner Options", function() FlxG.state.optionsCodex.switchPage('siiva'));
		if (exit != null) {
			optionspage.items.members.remove(option);
			optionspage.items.members.insert(optionspage.items.members.indexOf(exit), option);
		}
		for (i in 0...optionspage.items.length){
			var item = optionspage.items.members[i];
			item.y = 100 + i * 100;
		}
		if (prefs != null) {
			prefs.createPrefItemCheckbox("Titlescreen Edits", "Randomly changes the titlescreen to one of two SiIvagunner Rips.", (value) -> {
				save.data.siivatitle = value;
				save.flush();
			}, save.data.siivatitle);
			prefs.createPrefItemCheckbox("Recharted Songs", "Enables recharts for some songs with bad charting.\n(E.g., DadBattle (In-Game Version), Thorns (Beta Mix))", (value) -> {
				save.data.siivarechart = value;
				save.flush();
			}, save.data.siivarechart);
			prefs.createPrefItemCheckbox("Replay Cutscenes", "Allows cutscenes to play again after beating a song.", (value) -> {
				save.data.siivacutscenes = value;
				save.flush();
			}, save.data.siivacutscenes);
			prefs.createPrefItemCheckbox("Death on Game Over", "Blueballs the player at the end of the song.\n(Only visual. Will still continue to results screen)", (value) -> {
				save.data.siivatitle = value;
				save.flush();
			}, save.data.siivatitle);
			prefs.createPrefItemCheckbox("Modern Tutorial Vocals", "Changes the vocals in Tutorial rips to use the new samples introduced in the Weekend update.", (value) -> {
				save.data.siivavocals = value;
				save.flush();
			}, save.data.siivavocals);
			prefs.createPrefItemCheckbox("Extreme Effects", "Enables extreme effects for rips (E.g., Spookeez (Beta Mix)).\n(WARNING: MAY CAUSE LAG)", (value) -> {
				save.data.siivaexfx = value;
				save.flush();
			}, save.data.siivaexfx);
			prefs.createPrefItemCheckbox("Rotten Glitch Shader", "Enables the glitch shaders for ROTTEN.\n(WARNING: MAY CRASH YOUR GAME ON SOME DEVICES IF ENABLED)", (value) -> {
				save.data.rottenshader = value;
				save.flush();
			}, save.data.rottenshader);
			// Don't exist yet
			/*prefs.createPrefItemCheckbox("Siiva Results Music", "Replaces the results music with custom rips made by me.", (value) -> {
				save.data.siivaresults = value;
				save.flush();
			}, save.data.siivaresults);*/
			prefs.createPrefItemCheckbox("Lunchbox Rips", "Enables a random Lunchbox rip during Senpai's dialogue.", (value) -> {
				save.data.siivalunch = value;
				save.flush();
			}, save.data.siivalunch);
			#if !mobile
			prefs.createPrefItemCheckbox("Old School Soundtray", "Brings back the original sound tray seen in FNF versions before The Weekend Update. (REQUIRES GAME RESTART)", (value) -> {
				save.data.siivatray = value;
				//DefaultSoundTray.soundTrayVersion(value);
				save.flush();
			}, save.data.siivatray);
			#end
			prefs.createPrefItemCheckbox("Old School Stutter", "Re-adds the removed note stutter from pre-Weekend 1.", (value) -> {
				save.data.siivastutter = value;
				save.flush();
			}, save.data.siivastutter);
			prefs.createPrefItemCheckbox("Static Opponent Strum", "Stops the opponent strumline from playing an animation, as well as removes their note hold covers.", (value) -> {
				save.data.siivastrum = value;
				save.flush();
			}, save.data.siivastrum);
			prefs.itemDesc.text = prefs.preferenceDesc[prefs.items.selectedIndex];
		}
	}
}